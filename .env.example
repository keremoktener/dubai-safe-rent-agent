# Deterministic demo. With no keys, the app stays in mock mode and never calls a model.
LLM_PROVIDER=mock

# Optional. Used when LLM_PROVIDER=openai, or when LLM_PROVIDER is unset and this key exists.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Used when LLM_PROVIDER=anthropic, or when LLM_PROVIDER is unset, OpenAI is empty, and this key exists.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Live government adapters are not wired. Leave these unset.
# MARKET_ADAPTER=sample
# TRAKHEESI_ADAPTER=sample
# DUBAI_PULSE_API_KEY=
# TRAKHEESI_API_BASE=
# TRAKHEESI_API_KEY=
